# ---------------------------------------------------------------------------
# Green Light — environment. Copy to .env.local and fill in.
# Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (§9) — project URL and the publishable/anon key are safe in the browser.
# Project `green-light`, ref kpuecrvdrkhemyvibyfa, eu-central-1.
NEXT_PUBLIC_SUPABASE_URL=https://kpuecrvdrkhemyvibyfa.supabase.co
# Supabase dashboard -> Project Settings -> API. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY — bypasses RLS. Used for admin account creation
# and for clearing the forced-password-change flag (§4). Must never be exposed
# to the client or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Inbound alias domain (§5.1): {handle}.{random}@<this domain>
NEXT_PUBLIC_INBOUND_DOMAIN=analyze.greenlight.com

# NVIDIA NIM — the AI evaluation engine, hosting Kimi K3 (moonshotai/kimi-k3).
# Supersedes an earlier Gemini choice per the client's explicit instruction.
# Unset: the analyzer falls back to a rule-based estimate, labelled as such.
# See the §12 note in the README before relying on this for production data.
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
# Optional. Model-specific; only send it if you know the model honours it.
NVIDIA_REASONING_EFFORT=

# Resend: outbound relay + the inbound webhook that receives forwarded offers (§5).
RESEND_API_KEY=
# Svix signing secret for POST /api/webhooks/resend. Unset = the endpoint
# returns 503 rather than accepting unsigned mail. Format: whsec_<base64>.
RESEND_INBOUND_WEBHOOK_SECRET=

# Basic platform stats (§9).
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Verified audience geography OAuth (§7.3), Pro/Elite only. Unset: the
# connect button on Media Kit returns a clear "not configured" state instead
# of a real redirect.
#
# The base URL this app is reachable at — needed to build the OAuth
# redirect_uri (e.g. https://app.example.com, no trailing slash).
NEXT_PUBLIC_APP_URL=
# Google Cloud project with the yt-analytics.readonly scope. Sensitive scope:
# needs Google's OAuth verification review (not a full CASA audit).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Meta app, approved via App Review for instagram_manage_insights. Only
# works for a Business/Creator Instagram account linked to a Facebook Page.
META_APP_ID=
META_APP_SECRET=

# Discord ops notifications (src/lib/discord/logger.ts). Each is a full
# webhook URL — https://discord.com/api/webhooks/<id>/<token> — which IS the
# credential for posting to that channel. Never commit real values here or
# anywhere else; only .env.local, which .gitignore excludes.
DISCORD_SUPABASE_WEBHOOK_URL=
DISCORD_GITHUB_WEBHOOK_URL=
DISCORD_DEPLOYS_WEBHOOK_URL=

# Shared secret for POST /api/webhooks/supabase (Supabase Database Webhooks).
# Configure the webhook in the Supabase dashboard with a custom header:
#   Authorization: Bearer <this value>
# Unset = the endpoint returns 503 rather than accepting unauthenticated calls.
SUPABASE_WEBHOOK_SECRET=
